# Flask Secret Key
SECRET_KEY=your_secret_key_here

# Database Configuration (MySQL - automatically falls back to SQLite users.db if unavailable)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=project_db

# SMTP Email Configuration (Supports Gmail SMTP with App Password)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_DEFAULT_SENDER=your-email@gmail.com

# System Timezone
TIMEZONE=Asia/Kolkata

# Follow-up scheduler check interval in seconds (default: 60)
SCHEDULER_INTERVAL=60
